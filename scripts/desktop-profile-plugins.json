{
  "profile": "desktop",
  "shippedBundles": [
    "@deepseek-ai/dsh-base",
    "@deepseek-ai/dsh-web-app",
    "@deepseek-ai/dsh-desktop-app"
  ],
  "plugins": [
    {
      "name": "@deepseek-ai/dsh-experimental-desktop-files",
      "version": "0.1.2-alpha.2",
      "source": "workspace",
      "path": "packages/experimental/desktop-files"
    },
    {
      "name": "@yejiming/dsh-data-agent",
      "version": "0.1.3"
    },
    {
      "name": "@deepseek-ai/dsh-experimental-desktop-ask-data",
      "version": "0.1.2-alpha.2",
      "source": "workspace",
      "path": "packages/experimental/desktop-ask-data"
    },
    {
      "name": "@deepseek-ai/dsh-experimental-desktop-ask-knowledge",
      "version": "0.1.2-alpha.2",
      "source": "workspace",
      "path": "packages/experimental/desktop-ask-knowledge"
    },
    {
      "name": "@deepseek-ai/dsh-experimental-client-ui-agent-team",
      "version": "0.1.2-rc.1",
      "source": "workspace",
      "path": "packages/experimental/client-ui-agent-team"
    }
  ]
}
