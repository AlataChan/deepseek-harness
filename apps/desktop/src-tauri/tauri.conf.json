{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "octopus_DSH",
  "version": "0.1.2-rc.1",
  "identifier": "studio.octopus.dsh",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "pnpm --filter @deepseek-ai/dsh-desktop run build",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm exec vite --config apps/desktop/vite.config.ts"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "octopus_DSH",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; frame-src 'self' blob:; child-src 'self' blob:; script-src 'self' asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: https://asset.localhost; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": ["resources/installed-runtime-cli.js"],
    "icon": ["icons/icon.png", "icons/icon.icns"]
  }
}
