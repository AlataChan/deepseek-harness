{
  "name": "@deepseek-ai/dsh-working-directory-testkit",
  "version": "0.2.1-alpha.1",
  "description": "Explicit real directory owner setup for execution-consumer tests",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
