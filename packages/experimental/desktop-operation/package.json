{
  "name": "@deepseek-ai/dsh-experimental-desktop-operation",
  "description": "Desktop-operation preset that owns one shared macOS desktop session through pinned agent-desktop",
  "version": "0.2.1-alpha.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/desktop-operation"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "lib/supervisor.js",
    "preset/**",
    "native/LICENSE",
    "native/PIN.json",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "bundle": "tsc -b tsconfig.json && tsdown"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-mcp-client": "workspace:*",
    "@deepseek-ai/node-addon-system": "workspace:~",
    "@deepseek-ai/schemastery": "workspace:~",
    "js-yaml": "^4.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/dsh-agent-preset-registry": "workspace:*",
    "@deepseek-ai/dsh-home-paths": "workspace:*",
    "@deepseek-ai/dsh-agent": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/dsh-agent-preset-registry": "workspace:*",
    "@deepseek-ai/dsh-home-paths": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-system-prompt": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "^4.4.3",
    "@deepseek-ai/dsh-agent": "workspace:*"
  }
}
