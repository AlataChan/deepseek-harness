    "@deepseek-ai/dsh-util-values": "workspace:*",
    "@deepseek-ai/dsh-workflow-ptc": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "zod": "^4.4.3",
    "@deepseek-ai/dsh-experimental-im-feishu": "workspace:*",
    "@deepseek-ai/dsh-experimental-desktop-im": "workspace:*"
  },
  "peerDependencies": {
