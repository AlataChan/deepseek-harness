# Test-only Linux environment. The caller supplies a resolved immutable base digest.
ARG BASE_IMAGE=node:22-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d
FROM ${BASE_IMAGE}
ENV container=docker
RUN apt-get update && apt-get install -y --no-install-recommends \
    systemd systemd-sysv libpam-systemd dbus dbus-user-session openssh-server iproute2 procps psmisc sudo \
    build-essential musl-tools ca-certificates xz-utils \
    && systemctl disable ssh.service \
    && rm -rf /var/lib/apt/lists/*
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
