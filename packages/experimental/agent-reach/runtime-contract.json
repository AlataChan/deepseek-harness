          "name": "search",
          "help": "Search repositories",
          "usage": "agent-reach github search <query> [--limit LIMIT]",
          "params": [
            {
              "name": "query",
              "type": "string",
              "required": true,
              "default": null,
              "help": "what to search for"
            },
            {
              "name": "limit",
              "type": "number",
              "required": false,
              "default": 5,
              "help": "max results"
            }
          ],
          "backends": [
            {
              "name": "gh",
              "sideEffects": []
            },
            {
              "name": "github-api",
              "sideEffects": []
            }
          ],
          "publicWeb": []
        },
        {
          "name": "read",
          "help": "Read a repository (with README) or an issue / PR (with comments)",
          "usage": "agent-reach github read <target>",
          "params": [
            {
              "name": "target",
              "type": "string",
              "required": true,
              "default": null,
              "help": "owner/repo, or a repo / issue / PR link"
