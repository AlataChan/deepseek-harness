# Install as /etc/dsh-acp-worker.env, root:root 0644; provision all paths before enabling the SSH account.
DSH_ACP_NODE='/usr/local/bin/node'
DSH_ACP_CLI='/opt/dsh/node_modules/@deepseek-ai/dsh/lib/bin.js'
DSH_ACP_PATCH='/etc/dsh-acp-worker.patch.yml'
DSH_ACP_WORKSPACE='/home/dsh-acp-worker/workspace'
DSH_ACP_HOME='/home/dsh-acp-worker'
DSH_ACP_DSH_HOME='/home/dsh-acp-worker/.dsh'
DSH_ACP_TMPDIR='/home/dsh-acp-worker/tmp'
DSH_ACP_MAX_RUNTIME_SECONDS=120
DSH_ACP_STOP_SECONDS=5
DSH_ACP_CLEANUP_SECONDS=10
